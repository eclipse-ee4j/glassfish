<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.glassfish.main.orb</groupId>
        <artifactId>orb</artifactId>
        <version>8.0.5-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orb-http-server</artifactId>
    <packaging>jar</packaging>

    <name>GlassFish ORB over HTTP - server dispatch</name>

    <dependencies>
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Test scope only, and not a cycle: the client does not depend on the
            server. It is here so that HttpRoundTripTest can drive a real client
            proxy through the real wire format into the real server dispatch.
        -->
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ejb</groupId>
            <artifactId>jakarta.ejb-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
    </dependencies>
</project>
