<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
    version="3.0"
>
    <persistence-unit name="oracle" transaction-type="JTA">
        <jta-data-source>jdbc/__oracleDriverStub</jta-data-source>
        <class>org.glassfish.main.test.app.persistence.oracle.webapp.OracleEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!--
                Forces the platform from the EclipseLink Oracle extension instead of letting
                EclipseLink detect it, so that the platform class has to be loadable even though
                the database itself is never reached.
            -->
            <property name="eclipselink.target-database"
                value="org.eclipse.persistence.platform.database.oracle.Oracle21Platform"/>
        </properties>
    </persistence-unit>
</persistence>
