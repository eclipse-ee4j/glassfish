<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Tests using an OpenTelemetry SDK instance configured by the application -->
<suite name="MicroProfile Telemetry TCK - application" verbose="2" configfailurepolicy="continue">

    <test name="MicroProfile Telemetry TCK Setup">
        <classes>
            <class name="org.glassfish.microprofile.telemetry.tck.ContainerSetup" />
        </classes>
    </test>

    <!-- Includes the optional B3 and Jaeger propagation tests -->
    <test name="MicroProfile Telemetry Tracing TCK">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.tracing.tck.*" />
        </packages>
    </test>

    <test name="MicroProfile Telemetry Metrics TCK - application">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.metrics.tck.application.*" />
        </packages>
    </test>

    <test name="MicroProfile Telemetry Logs TCK - application">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.logs.tck.application.*" />
        </packages>
    </test>

</suite>
