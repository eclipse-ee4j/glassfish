<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>mongo-deps</id>
    <formats>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <dependencySets>
        <dependencySet>
            <includes>
                <include>org.eclipse.jnosql.databases:jnosql-mongodb</include>
                <include>org.slf4j:slf4j-jdk14</include>
            </includes>
            <excludes>
                <exclude>org.eclipse.jnosql.mapping:*</exclude>
                <exclude>jakarta.nosql:*</exclude>
            </excludes>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <useTransitiveFiltering>true</useTransitiveFiltering>
        </dependencySet>
        <dependencySet>
            <includes>
                <include>org.assertj:assertj-core</include>
                <include>net.datafaker:datafaker</include>
                <include>org.awaitility:awaitility</include>
                <include>org.junit.jupiter:junit-jupiter-params</include>
                <include>org.junit.jupiter:junit-jupiter-api</include>
                <include>org.apiguardian:apiguardian-api</include>
                <include>net.bytebuddy:byte-buddy</include>
            </includes>
            <scope>test</scope>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <useTransitiveFiltering>false</useTransitiveFiltering>
        </dependencySet>
    </dependencySets>
</assembly>
