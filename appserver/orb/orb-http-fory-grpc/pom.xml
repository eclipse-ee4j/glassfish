<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.glassfish.main.orb</groupId>
        <artifactId>orb</artifactId>
        <version>8.0.6-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orb-http-fory-grpc</artifactId>
    <packaging>glassfish-jar</packaging>
    <name>GlassFish ORB over HTTP - Fory gRPC bridge</name>
    <description>
        Fory IDL discovery and deploy-time EJB service metadata for clients
        generated by the Apache Fory compiler. gRPC framing and payload
        serialization remain owned by the official Fory/gRPC runtimes.
    </description>

    <properties>
        <fory.version>1.7.1</fory.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The endpoint this module serves under, and what it reads to find
             the beans. All of it is the server's at runtime, so none of it is
             bundled; the dependency points this way so that the endpoint does
             not need this module. -->
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-glassfish</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.ejb</groupId>
            <artifactId>ejb-container</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.common</groupId>
            <artifactId>internal-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.deployment</groupId>
            <artifactId>dol</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.hk2</groupId>
            <artifactId>hk2-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.fory</groupId>
            <artifactId>fory-core</artifactId>
            <version>${fory.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Embed-Dependency>groupId=org.apache.fory;artifactId=fory-core</Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <Multi-Release>true</Multi-Release>
                        <Import-Package>!org.apache.fory.*,*;resolution:=optional</Import-Package>
                        <!-- The bundle goal builds the jar from these instructions
                             alone, so without this the HK2 descriptor stays in
                             target/classes and the extension is never found. -->
                        <Include-Resource>
                            {maven-resources},
                            META-INF/hk2-locator/=target/classes/META-INF/hk2-locator/,
                        </Include-Resource>
                    </instructions>
                </configuration>
                <executions>
                    <execution>
                        <!--
                            The glassfish-jar lifecycle only writes the manifest. Without
                            this the bundle would declare a Bundle-ClassPath entry for a
                            jar that is not inside it - it builds cleanly, installs, and
                            then cannot find org.apache.fory.Fory on the first call.
                        -->
                        <id>osgi-bundle</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
