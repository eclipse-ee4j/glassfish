<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Tests using the OpenTelemetry SDK instance created by the runtime, enabled by environment variables -->
<suite name="MicroProfile Telemetry TCK - runtime" verbose="2" configfailurepolicy="continue">

    <test name="MicroProfile Telemetry TCK Setup">
        <classes>
            <class name="org.glassfish.microprofile.telemetry.tck.ContainerSetup" />
        </classes>
    </test>

    <test name="MicroProfile Telemetry Metrics TCK - JVM">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.metrics.tck.jvm.*" />
        </packages>
    </test>

    <test name="MicroProfile Telemetry Logs TCK - runtime">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.logs.tck.config.*" />
        </packages>
    </test>

</suite>
