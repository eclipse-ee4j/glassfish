<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.glassfish.main.orb</groupId>
        <artifactId>orb</artifactId>
        <version>8.0.5-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orb-http-glassfish</artifactId>
    <packaging>glassfish-jar</packaging>

    <name>GlassFish ORB over HTTP - container integration</name>
    <description>
        Binds the transport-neutral dispatch in orb-http-server to this
        container: ContainerBridge onto EjbContainerFacade, NamingBridge onto
        the naming service's TransientContext, SecurityBridge onto
        SecurityContext. This is the only module in the transport that depends
        on GlassFish internals, which is why it is a module of its own.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.orb</groupId>
            <artifactId>orb-http-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.ejb</groupId>
            <artifactId>ejb-container</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.common</groupId>
            <artifactId>glassfish-naming</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.common</groupId>
            <artifactId>internal-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.deployment</groupId>
            <artifactId>dol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.security</groupId>
            <artifactId>security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.hk2</groupId>
            <artifactId>hk2-core</artifactId>
        </dependency>

        <!-- The endpoint mounts on the server's own HTTP listeners, which is
             what gives it their TLS configuration and their HTTP/2 settings
             without arranging either. -->
        <!--
            Read only, and provided: the scanner asks the framework which
            modules are installed. The server supplies this at runtime, so it
            must not be bundled.
        -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.core</groupId>
            <artifactId>kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.main.grizzly</groupId>
            <artifactId>nucleus-grizzly-all</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
    </dependencies>
</project>
